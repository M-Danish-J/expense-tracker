# Copy to .env.local and fill in your Supabase project's values.
# Find them under Project Settings → API in the Supabase dashboard.

# --- Required -----------------------------------------------------------
# Without these, pages build fine but every request fails at runtime.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# For a local stack, `supabase start` prints the URL and publishable key to use:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# --- Optional -----------------------------------------------------------
# The canonical origin, used for <link rel="canonical">, Open Graph URLs,
# sitemap.xml and the JSON-LD on the landing page (see lib/site.ts).
#
# Leave it unset locally — it falls back to http://localhost:3000. On Vercel it
# falls back to the per-deployment hostname, which means every preview
# advertises itself as canonical, so set it to your real domain in production.

# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Deliberately absent ------------------------------------------------
# There is no service-role/secret key here. The application never needs one:
# every query runs as the signed-in user and is constrained by Row Level
# Security. A secret key in this file would end up in the browser bundle the
# moment someone prefixed it with NEXT_PUBLIC_.
